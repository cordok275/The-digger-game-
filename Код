// ---------- canvas-generated textures (no external assets needed) ----------
function makeCanvasTexture(draw, w, h) {
  const c = document.createElement('canvas');
  c.width = w; c.height = h;
  const ctx = c.getContext('2d');
  draw(ctx, w, h);
  const tex = new THREE.CanvasTexture(c);
  tex.needsUpdate = true;
  return tex;
}
function posterTexture(lines, accent) {
  return makeCanvasTexture((ctx, w, h) => {
    ctx.fillStyle = '#d9d0ac'; ctx.fillRect(0, 0, w, h);
    ctx.fillStyle = accent; ctx.fillRect(0, 0, w, 10); ctx.fillRect(0, h - 10, w, 10);
    ctx.strokeStyle = accent; ctx.lineWidth = 4; ctx.strokeRect(6, 6, w - 12, h - 12);
    ctx.fillStyle = '#241d10'; ctx.textAlign = 'center';
    let y = 46;
    lines.forEach((line, i) => {
      ctx.font = i === 0 ? 'bold 24px monospace' : '16px monospace';
      ctx.fillText(line, w / 2, y);
      y += i === 0 ? 34 : 24;
    });
  }, 256, 170);
}
function labelTexture(text) {
  return makeCanvasTexture((ctx, w, h) => {
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = 'rgba(10,7,4,0.78)';
    ctx.fillRect(0, h * 0.3, w, h * 0.42);
    ctx.fillStyle = '#f0d78c';
    ctx.textAlign = 'center';
    ctx.font = 'bold 30px monospace';
    ctx.fillText(text, w / 2, h * 0.58);
  }, 256, 80);
}
function grateTexture() {
  return makeCanvasTexture((ctx, w, h) => {
    ctx.fillStyle = '#2e2a1f'; ctx.fillRect(0, 0, w, h);
    ctx.strokeStyle = '#17140d'; ctx.lineWidth = 6;
    for (let x = 0; x <= w; x += 22) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke(); }
    for (let y = 0; y <= h; y += 22) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke(); }
  }, 128, 128);
}
function dialTexture() {
  return makeCanvasTexture((ctx, w, h) => {
    ctx.fillStyle = '#1c1811'; ctx.fillRect(0, 0, w, h);
    for (let i = 0; i < 4; i++) {
      const cx = 32 + i * 64, cy = h / 2, r = 22;
      ctx.strokeStyle = '#c9a24a'; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2); ctx.stroke();
      const a = 0.6 + i * 0.9;
      ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + r * Math.cos(a), cy + r * Math.sin(a)); ctx.stroke();
    }
  }, 256, 90);
}
function grassTexture() {
  return makeCanvasTexture((ctx, w, h) => {
    ctx.fillStyle = '#2e2a1a'; ctx.fillRect(0, 0, w, h);
    for (let i = 0; i < 900; i++) {
      const x = Math.random() * w, y = Math.random() * h;
      const g = 30 + Math.random() * 46;
      ctx.fillStyle = `rgba(${g + 20},${g + 32},${g - 6},0.55)`;
      ctx.fillRect(x, y, 2, 2);
    }
  }, 128, 128);
}
function concreteTexture(c1, c2) {
  return makeCanvasTexture((ctx, w, h) => {
    ctx.fillStyle = c1; ctx.fillRect(0, 0, w, h);
    for (let i = 0; i < 1500; i++) {
      const x = Math.random() * w, y = Math.random() * h, s = 1 + Math.random() * 3;
      ctx.globalAlpha = 0.07 + Math.random() * 0.2;
      ctx.fillStyle = c2;
      ctx.fillRect(x, y, s, s);
    }
    ctx.globalAlpha = 1;
  }, 128, 128);
}


// ---------- distinct low-poly gas mask silhouettes ----------
function buildMaskModel(type, color) {
  const group = new THREE.Group();
  const rubber = new THREE.MeshStandardMaterial({ color, roughness: 0.75 });
  const lens = new THREE.MeshStandardMaterial({ color: 0x0c1210, roughness: 0.25, metalness: 0.4 });
  const metalPart = new THREE.MeshStandardMaterial({ color: 0x2c2c26, roughness: 0.5, metalness: 0.6 });

  if (type === 'gp5' || type === 'shp5') {
    const s = type === 'shp5' ? 0.82 : 1;
    const head = new THREE.Mesh(new THREE.SphereGeometry(0.22 * s, 12, 10), rubber);
    head.scale.set(1, 1.1, 0.9); head.position.set(0, 0.55, 0);
    const visor = new THREE.Mesh(new THREE.BoxGeometry(0.3 * s, 0.1 * s, 0.05), lens);
    visor.position.set(0, 0.6, 0.19 * s); visor.rotation.x = -0.15;
    const hose = new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.035, 0.35, 6), rubber);
    hose.position.set(0.18, 0.35, 0.1); hose.rotation.z = 0.9;
    const filter = new THREE.Mesh(new THREE.CylinderGeometry(0.09, 0.09, 0.28, 8), metalPart);
    filter.position.set(0.3, 0.2, 0.12); filter.rotation.z = Math.PI / 2.2;
    group.add(head, visor, hose, filter);
  } else if (type === 'pmg2') {
    const head = new THREE.Mesh(new THREE.SphereGeometry(0.22, 12, 10), rubber);
    head.scale.set(1, 1.05, 0.9); head.position.set(0, 0.55, 0);
    const eyeL = new THREE.Mesh(new THREE.CylinderGeometry(0.055, 0.055, 0.03, 10), lens);
    eyeL.position.set(-0.09, 0.58, 0.18); eyeL.rotation.x = Math.PI / 2;
    const eyeR = eyeL.clone(); eyeR.position.x = 0.09;
    const filter = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 0.22, 8), metalPart);
    filter.position.set(0, 0.48, 0.26); filter.rotation.x = Math.PI / 2;
    group.add(head, eyeL, eyeR, filter);
  } else if (type === 'homyak') {
    const head = new THREE.Mesh(new THREE.BoxGeometry(0.32, 0.34, 0.26), rubber);
    head.position.set(0, 0.55, 0);
    const visor = new THREE.Mesh(new THREE.BoxGeometry(0.26, 0.16, 0.04), lens);
    visor.position.set(0, 0.58, 0.15);
    const hose = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 0.3, 6), new THREE.MeshStandardMaterial({ color: 0x1c1c18, roughness: 0.7 }));
    hose.position.set(0.2, 0.35, 0.05); hose.rotation.z = 1.1;
    const filter = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 0.2, 8), metalPart);
    filter.position.set(0.32, 0.22, 0.05); filter.rotation.z = Math.PI / 2.2;
    group.add(head, visor, hose, filter);
  } else if (type === 'nerekhta') {
    const head = new THREE.Mesh(new THREE.BoxGeometry(0.32, 0.34, 0.26), rubber);
    head.position.set(0, 0.55, 0);
    const visor = new THREE.Mesh(new THREE.BoxGeometry(0.27, 0.17, 0.04), lens);
    visor.position.set(0, 0.58, 0.15);
    const filterL = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.07, 0.18, 8), metalPart);
    filterL.position.set(-0.22, 0.5, 0.05); filterL.rotation.z = Math.PI / 2;
    const filterR = filterL.clone(); filterR.position.x = 0.22;
    group.add(head, visor, filterL, filterR);
  } else {
    const head = new THREE.Mesh(new THREE.SphereGeometry(0.2, 10, 8), rubber);
    head.scale.set(1, 1.05, 0.85); head.position.set(0, 0.55, 0);
    const eyeL = new THREE.Mesh(new THREE.CylinderGeometry(0.045, 0.045, 0.025, 8), lens);
    eyeL.position.set(-0.08, 0.57, 0.16); eyeL.rotation.x = Math.PI / 2;
    const eyeR = eyeL.clone(); eyeR.position.x = 0.08;
    const filter = new THREE.Mesh(new THREE.CylinderGeometry(0.075, 0.06, 0.22, 8), metalPart);
    filter.position.set(0, 0.4, 0.05); filter.rotation.x = 0.3;
    group.add(head, eyeL, eyeR, filter);
  }
  return group;
}

export default function DiggersGame() {
  const mountRef = useRef(null);
  const gameRef = useRef(null);
  const [screen, setScreen] = useState('start'); // start | playing | won | time
  const [isTouch, setIsTouch] = useState(false);
  const [maskWorn, setMaskWorn] = useState(false);

  const maskRef = useRef(null);
  const ammoRef = useRef(null);
  const lootRef = useRef(null);
  const battRef = useRef(null);
  const timeRef = useRef(null);
  const toastRef = useRef(null);
  const promptRef = useRef(null);
  const interactBtnRef = useRef(null);
  const maskToggleRef = useRef(null);
  const joystickZoneRef = useRef(null);
  const joystickKnobRef = useRef(null);

  useEffect(() => {
    setIsTouch(('ontouchstart' in window) || navigator.maxTouchPoints > 0);
  }, []);

  const showToast = useCallback((msg) => {
    const el = toastRef.current;
    if (!el) return;
    el.textContent = msg;
    el.style.opacity = 1;
    clearTimeout(el._t);
    el._t = setTimeout(() => { el.style.opacity = 0; }, 1300);
  }, []);

  const toggleMaskWear = useCallback(() => {
    const game = gameRef.current;
    if (!game) return;
    if (!game.inventory || game.inventory.length === 0) { showToast('НЕЧЕГО НАДЕТЬ'); return; }
    game.wornMask = !game.wornMask;
    setMaskWorn(game.wornMask);
    showToast(game.wornMask ? 'ПРОТИВОГАЗ НАДЕТ' : 'ПРОТИВОГАЗ СНЯТ');
  }, [showToast]);

  // ---------------- SETUP THREE.JS (once) ----------------
  useEffect(() => {
    const mount = mountRef.current;
    if (!mount) return;
    const isMobile = ('ontouchstart' in window) || navigator.maxTouchPoints > 0;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0d0906);
    scene.fog = new THREE.FogExp2(0x151009, 0.026);

    const camera = new THREE.PerspectiveCamera(72, mount.clientWidth / mount.clientHeight, 0.05, 100);
    const renderer = new THREE.WebGLRenderer({ antialias: !isMobile, powerPreference: 'high-performance' });
    renderer.setSize(mount.clientWidth, mount.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.4 : 2));
    renderer.outputEncoding = THREE.sRGBEncoding;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;
    mount.appendChild(renderer.domElement);
    renderer.domElement.style.touchAction = 'none';
    renderer.domElement.style.cursor = 'grab';

    const ambient = new THREE.AmbientLight(0x3a2c18, 0.85);
    scene.add(ambient);
    const moon = new THREE.DirectionalLight(0x9fb4d4, 0.3);
    moon.position.set(-30, 20, 10);
    scene.add(moon);

    const FLASH_BASE = 2.7, FILL_BASE = 0.6;
    const flashlight = new THREE.SpotLight(0xffe0ae, FLASH_BASE, 21, Math.PI / 5.6, 0.45, 1.05);
    camera.add(flashlight);
    flashlight.position.set(0, 0, 0);
    flashlight.target.position.set(0, 0, -1);
    camera.add(flashlight.target);
    const flashFill = new THREE.PointLight(0xffb347, FILL_BASE, 4.5, 2);
    flashFill.position.set(0, -0.1, 0.3);
    camera.add(flashFill);
    scene.add(camera);

    // ---------- materials ----------
    const wallTex = concreteTexture('#3d3527', '#5f5138');
    wallTex.wrapS = wallTex.wrapT = THREE.RepeatWrapping; wallTex.repeat.set(3, 1.4);
    const wallMat = new THREE.MeshStandardMaterial({ map: wallTex, roughness: 0.92 });

    const floorTex = concreteTexture('#20190f', '#382c1c');
    floorTex.wrapS = floorTex.wrapT = THREE.RepeatWrapping; floorTex.repeat.set(10, 6);
    const floorMat = new THREE.MeshStandardMaterial({ map: floorTex, roughness: 1.0 });

    const ceilMat = new THREE.MeshStandardMaterial({ color: 0x171009, roughness: 1.0 });
    const ventWallMat = new THREE.MeshStandardMaterial({ color: 0x4a4234, roughness: 0.7, metalness: 0.35 });
    const ventFloorMat = new THREE.MeshStandardMaterial({ color: 0x332d22, roughness: 0.8, metalness: 0.2 });
    const ventCeilMat = new THREE.MeshStandardMaterial({ color: 0x282318, roughness: 0.8, metalness: 0.2 });
    const grateMat = new THREE.MeshStandardMaterial({ map: grateTexture(), roughness: 0.6, metalness: 0.5 });
    const metalMat = new THREE.MeshStandardMaterial({ color: 0x3d3d33, roughness: 0.6, metalness: 0.4 });
    const woodMat = new THREE.MeshStandardMaterial({ color: 0x342e21, roughness: 0.85 });
    const crateMat = new THREE.MeshStandardMaterial({ color: 0x4a3a24, roughness: 0.9 });
    const lootMat = new THREE.MeshStandardMaterial({ color: 0x4a5232, roughness: 0.85 });
    const fenceMat = new THREE.MeshStandardMaterial({ color: 0x4a3a28, roughness: 0.9 });
    const concreteMat = new THREE.MeshStandardMaterial({ color: 0x5a5648, roughness: 0.95 });
    const boothMat = new THREE.MeshStandardMaterial({ color: 0x4a4436, roughness: 0.9 });
    const carMat = new THREE.MeshStandardMaterial({ color: 0x5a3a2a, roughness: 0.95, metalness: 0.1 });
    const carMat2 = new THREE.MeshStandardMaterial({ color: 0x4a2f22, roughness: 0.95 });
    const wheelMat = new THREE.MeshStandardMaterial({ color: 0x101010, roughness: 0.9 });
    const trunkMat = new THREE.MeshStandardMaterial({ color: 0x3a2c1c, roughness: 0.9 });
    const foliageMat = new THREE.MeshStandardMaterial({ color: 0x334423, roughness: 0.9 });
    const hermaMat = new THREE.MeshStandardMaterial({ color: 0xd08a2a, roughness: 0.55 });
    const ropeMat = new THREE.MeshStandardMaterial({ color: 0x8a7040, roughness: 0.9 });

    const grassTex = grassTexture();
    grassTex.wrapS = grassTex.wrapT = THREE.RepeatWrapping; grassTex.repeat.set(14, 14);
    const groundMat = new THREE.MeshStandardMaterial({ map: grassTex, roughness: 1.0 });

    const wallBoxes = [];
    const sprayTargets = [];
    const grates = [];
    const ventZones = [];

    function addBox(x, y, z, w, h, d, mat, collide) {
      const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
      mesh.position.set(x, y, z);
      scene.add(mesh);
      sprayTargets.push(mesh);
      if (collide !== false) wallBoxes.push({ min: { x: x - w / 2, z: z - d / 2 }, max: { x: x + w / 2, z: z + d / 2 } });
      return mesh;
    }
    function addProp(x, y, z, w, h, d, mat, rotY, collide) {
      const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
      mesh.position.set(x, y, z);
      if (rotY) mesh.rotation.y = rotY;
      scene.add(mesh);
      if (collide) wallBoxes.push({ min: { x: x - w / 2, z: z - d / 2 }, max: { x: x + w / 2, z: z + d / 2 } });
      return mesh;
    }
    function addCyl(x, y, z, r, h, mat, rotX, rotZ) {
      const mesh = new THREE.Mesh(new THREE.CylinderGeometry(r, r, h, 10), mat);
      mesh.position.set(x, y, z);
      if (rotX) mesh.rotation.x = rotX;
      if (rotZ) mesh.rotation.z = rotZ;
      scene.add(mesh);
      return mesh;
    }

    // ---------- floors / ceiling ----------
    const indoorFloor = new THREE.Mesh(new THREE.PlaneGeometry(44, 28), floorMat);
    indoorFloor.rotation.x = -Math.PI / 2; indoorFloor.position.set(22, 0, 0);
    scene.add(indoorFloor);
    const outdoorGround = new THREE.Mesh(new THREE.PlaneGeometry(28, 28), groundMat);
    outdoorGround.rotation.x = -Math.PI / 2; outdoorGround.position.set(-14, 0, 0);
    scene.add(outdoorGround);
    const bigCeil = new THREE.Mesh(new THREE.PlaneGeometry(40, 18), ceilMat);
    bigCeil.rotation.x = Math.PI / 2; bigCeil.position.set(20, WALL_H, 0);
    scene.add(bigCeil);

    // ---------- outdoor yard ----------
    const FX1 = -28, FX2 = 44, FZ1 = -14, FZ2 = 14;
    addBox((FX1 + FX2) / 2, 1.2, FZ1, FX2 - FX1, 2.4, 0.2, fenceMat);
    addBox((FX1 + FX2) / 2, 1.2, FZ2, FX2 - FX1, 2.4, 0.2, fenceMat);
    addBox(FX1, 1.2, (FZ1 + FZ2) / 2, 0.2, 2.4, FZ2 - FZ1, fenceMat);
    addBox(FX2, 1.2, (FZ1 + FZ2) / 2, 0.2, 2.4, FZ2 - FZ1, fenceMat);

    function addTree(x, z) {
      addCyl(x, 0.6, z, 0.13, 1.2, trunkMat);
      const foliage = new THREE.Mesh(new THREE.ConeGeometry(1.1, 2.2, 8), foliageMat);
      foliage.position.set(x, 1.9, z);
      scene.add(foliage);
    }
    addTree(-22, 9); addTree(-8, -10); addTree(-25, -3); addTree(-6, 10);

    function addRubble(x, z, rot) { addProp(x, 0.08, z, 1.4, 0.16, 1.0, concreteMat, rot); }
    addRubble(-18, -3, 0.4); addRubble(-6, 6, -0.3); addRubble(-15, 11, 0.9);

    addProp(-10, 0.55, -9, 2.3, 0.7, 1.1, carMat, 0, true);
    addProp(-10, 1.05, -9, 1.1, 0.4, 1.0, carMat2, 0);
    [[-0.9, -0.5], [-0.9, 0.5], [0.9, -0.5], [0.9, 0.5]].forEach(([ox, oz]) => {
      addCyl(-10 + ox, 0.28, -9 + oz, 0.28, 0.22, wheelMat, Math.PI / 2, 0);
    });

    addProp(-24, 1.1, 10, 1.3, 2.2, 1.3, boothMat, 0, true);
    addProp(-24, 2.35, 10, 1.7, 0.15, 1.7, boothMat);

    // digger gear cache — right beside the walking path to the hatch, lit so it can't be missed
    const gearLight = new THREE.PointLight(0xffc46a, 1.1, 6, 2);
    gearLight.position.set(-3.3, 1.2, 0.9);
    scene.add(gearLight);
    const herma = new THREE.Mesh(new THREE.CylinderGeometry(0.26, 0.26, 0.62, 12), hermaMat);
    herma.position.set(-3.3, 0.3, 0.9); herma.rotation.z = Math.PI / 2.3;
    scene.add(herma);
    const rope = new THREE.Mesh(new THREE.TorusGeometry(0.24, 0.055, 8, 16), ropeMat);
    rope.position.set(-3.7, 0.09, 1.7); rope.rotation.x = Math.PI / 2;
    scene.add(rope);
    [0, 1, 2].forEach(i => addCyl(-2.5 + i * 0.24, 0.19, 1.3, 0.095, 0.38, new THREE.MeshStandardMaterial({ color: 0x5a6a3a, roughness: 0.6, metalness: 0.3 })));

    const hatchRim = new THREE.Mesh(new THREE.CylinderGeometry(0.9, 0.9, 0.15, 16), concreteMat);
    hatchRim.position.set(-1, 0.08, 0);
    scene.add(hatchRim);
    const hatchLid = new THREE.Mesh(new THREE.CylinderGeometry(0.8, 0.8, 0.06, 16), metalMat);
    hatchLid.position.set(-2.1, 0.05, 1.0);
    hatchLid.rotation.x = Math.PI / 2.3; hatchLid.rotation.z = 0.3;
